<mujoco model="l1_w_arm scene">
  <include file="l1_w_with_arm.xml"/>

  <statistic center="0 0 0.45" extent="0.9" meansize="0.04"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <map fogstart="100.0" fogend="300.0"/>
    <rgba haze="0.75 0.75 0.77 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.55 0.57" rgb2="0.55 0.55 0.57" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" rgb1="0.62 0.62 0.63" rgb2="0.49 0.49 0.51"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="1.25 1.25" reflectance="0.0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <sensor>
    <contact name="FBL_foot_contact" geom1="floor" geom2="FBL_FOOT" data="found" num="1" reduce="mindist"/>
    <contact name="FAR_foot_contact" geom1="floor" geom2="FAR_FOOT" data="found" num="1" reduce="mindist"/>
    <contact name="RAR_foot_contact" geom1="floor" geom2="RAR_FOOT" data="found" num="1" reduce="mindist"/>
    <contact name="RBL_foot_contact" geom1="floor" geom2="RBL_FOOT" data="found" num="1" reduce="mindist"/>
    <contact name="base_contact" geom1="floor" geom2="base_collision" data="found" num="1" reduce="mindist"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="
    0 0 0.4
    1 0 0 0
    0 0.8 -1.5 0 0 0.8 -1.5 0 0 0.8 -1.5 0 0 0.8 -1.5 0
    0 0 0 1.6 0 -1.6"
      ctrl="0 0.8 -1.5 0 0.8 -1.5 0 0.8 -1.5 0 0.8 -1.5 0 0 0 0 0 0 0 1.6 0 -1.6"/>
  </keyframe>
</mujoco>
